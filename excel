     */
    const CASES_DATA = [
      {
        id: 0,
        code: 'Kasus 1',
        level: 'Near Transfer',
        levelColor: 'emerald',
        transferWeight: 20,
        title: 'Rekap Kas & Kehadiran Piket',
        fileName: 'Rekap_Piket_Kelas.xlsx',
        narrative:
          'Sekretaris kelas mencatat daftar kehadiran piket kebersihan pada kolom C. Siswa yang bertugas piket menuliskan teks "Hadir", sedangkan siswa yang tidak hadir dibiarkan kosong.',
        mission:
          'Hitunglah jumlah siswa yang hadir piket pada sel target C8 menggunakan rentang data C2:C7.',
        trapHint:
          'Waspada Jebakan Hafalan: Banyak siswa mengira semua perintah "menghitung jumlah" selalu memakai fungsi COUNT. Perhatikan tipe data pada kolom C!',
        cols: ['A', 'B', 'C'],
        grid: [
          ['No', 'Nama Siswa', 'Status Piket'],
          [1, 'Andi Pratama', 'Hadir'],
          [2, 'Bunga Citra', ''],
          [3, 'Candra Wijaya', 'Hadir'],
          [4, 'Dina Kartika', 'Hadir'],
          [5, 'Eko Saputra', ''],
          [6, 'Fitriani', 'Hadir'],
          ['', 'Total Siswa Hadir', ''],
        ],
        targetCells: ['C8'],
        primaryTargetCell: 'C8',
        refCells: [],
        expectedOutputs: { C8: 4 },
        // Phase 1: Two-Tier Diagnostic
        functionOptions: [
          { name: 'SUM', desc: 'Menjumlahkan nilai angka' },
          { name: 'AVERAGE', desc: 'Mencari rata-rata angka' },
          { name: 'COUNT', desc: 'Mencacah sel berisi angka' },
          { name: 'COUNTA', desc: 'Mencacah sel tidak kosong' },
          { name: 'IF', desc: 'Uji syarat logika' },
        ],
        correctFunction: 'COUNTA',
        reasonOptions: [
          {
            id: 'r1',
            text: 'Karena kita ingin menjumlahkan seluruh angka yang ada pada kolom status piket.',
            isCorrect: false,
            hint: 'Kolom C berisi teks "Hadir", bukan bilangan yang bisa dijumlahkan secara aritmetika.',
          },
          {
            id: 'r2',
            text: 'Karena COUNT hanya menghitung sel berisi angka (hasilnya 0 pada teks), sedangkan COUNTA menghitung semua sel yang tidak kosong.',
            isCorrect: true,
            hint: '',
          },
          {
            id: 'r3',
            text: 'Karena fungsi COUNT otomatis menghitung baik sel angka maupun sel berisi huruf secara bersamaan.',
            isCorrect: false,
            hint: 'Hati-hati! Ini miskonsepsi umum: fungsi COUNT di Excel mengabaikan teks dan hanya menghitung sel numerik.',
          },
          {
            id: 'r4',
            text: 'Karena kita ingin menampilkan teks "Lulus" atau "Tidak" pada setiap baris siswa.',
            isCorrect: false,
            hint: 'Kita hanya membutuhkan satu angka rekap total kehadiran di sel C8, bukan label per baris.',
          },
        ],
        // Phase 2: Mental Tracing Questions
        predictions: [
          {
            id: 'p1',
            label: 'Simulasi Jebakan: Jika seseorang keliru memakai =COUNT(C2:C7) pada data teks di atas, angka berapa yang muncul?',
            type: 'select',
            options: ['0', '4', '6', '#VALUE!'],
            correctAnswer: '0',
            explanation: 'COUNT hanya menghitung angka, sehingga pada sel teks "Hadir" hasilnya adalah 0.',
          },
          {
            id: 'p2',
            label: 'Prediksi Target (C8): Dengan fungsi COUNTA pada rentang C2:C7, berapa hasil akhir yang akan muncul di sel C8?',
            type: 'number',
            placeholder: 'Masukkan angka prediksi...',
            correctAnswer: '4',
            explanation: 'Terdapat 4 sel yang terisi teks "Hadir" dan 2 sel kosong.',
          },
        ],
        // Phase 3: Comparison rows & Custom Diagnostics
        comparisonSamples: [
          { label: 'Sel C8 (Total Siswa Hadir)', cell: 'C8', predictionKey: 'p2', expected: 4 },
        ],
        diagnoseFormula(rawFormula, evalResults) {
          const upper = rawFormula.toUpperCase();
          if (upper.includes('COUNT(') && !upper.includes('COUNTA(') && !upper.includes('COUNTIF(')) {
            return {
              type: 'trap',
              title: 'Jebakan Konseptual Terdeteksi: COUNT vs COUNTA!',
              message:
                'Rumusmu memakai <code>COUNT</code> yang hanya menghitung sel berisi <b>angka</b>. Karena sel <code>C2:C7</code> berisi teks <code>"Hadir"</code>, Excel menghasilkan <b>0</b>. Ganti dengan <code>COUNTA(C2:C7)</code> untuk menghitung sel yang tidak kosong!',
            };
          }
          if (upper.includes('SUM(')) {
            return {
              type: 'logic',
              title: 'Fungsi Kurang Tepat: SUM Hanya untuk Angka',
              message:
                '<code>SUM</code> berfungsi menjumlahkan nilai numerik, bukan mencacah berapa banyak sel teks yang terisi. Gunakan <code>COUNTA(C2:C7)</code>.',
            };
          }
          if (!upper.includes('C2:C7')) {
