    function renderSpreadsheetGrid() {
      const c = CASES_DATA[currentCaseIdx];
      const st = caseStates[currentCaseIdx];
      const table = document.getElementById('excelGridTable');

      // Header Row (A, B, C...)
      let html = '<thead><tr class="bg-slate-100 border-b border-slate-300 text-slate-600 font-mono text-xs">';
      html += '<th class="w-10 py-2 px-2 text-center border-r border-slate-300 bg-slate-200/70"></th>';
      c.cols.forEach((col) => {
        html += `<th class="py-2 px-3 text-center font-bold border-r border-slate-300 min-w-[95px]">${col}</th>`;
      });
      html += '</tr></thead><tbody>';

      // Data Rows
      c.grid.forEach((row, rIdx) => {
        const rowNum = rIdx + 1;
        const isHeaderRow = rIdx === 0;
        html += `<tr class="${isHeaderRow ? 'bg-slate-50 font-bold text-slate-800' : 'bg-white text-slate-700'} border-b border-slate-200">`;
        html += `<td class="py-2 px-2 text-center font-mono text-xs font-semibold text-slate-500 bg-slate-100 border-r border-slate-300">${rowNum}</td>`;

        c.cols.forEach((col, cIdx) => {
          const coord = `${col}${rowNum}`;
          const isTarget = c.targetCells.includes(coord);
          const isRef = c.refCells.includes(coord);
          const isSelected = selectedCellCoord === coord;

          let rawVal = row[cIdx] !== undefined ? row[cIdx] : '';
          let displayVal = rawVal;

          // If target cell has been evaluated in Phase 3, display its live calculated output
          if (isTarget) {
            if (st.evaluatedCells[coord] !== undefined) {
              displayVal = st.evaluatedCells[coord];
            } else {
              displayVal = '?';
            }
          } else if (typeof rawVal === 'number' && c.id === 2 && col === 'D') {
            displayVal = rawVal.toLocaleString('id-ID');
          }

          let cellClasses = 'py-2 px-3 border-r border-slate-200 cursor-pointer transition relative ';
          if (typeof rawVal === 'number' || isTarget) {
            cellClasses += 'font-mono ';
          }
          if (typeof rawVal === 'number' && !isTarget) {
            cellClasses += 'text-right ';
          }
          if (isTarget) {
            const isCorrectVal = st.evaluatedCells[coord] === c.expectedOutputs[coord];
            if (st.evaluatedCells[coord] !== undefined) {
              cellClasses += isCorrectVal
                ? 'bg-emerald-100/90 text-excel-800 font-extrabold text-center '
                : 'bg-rose-100 text-rose-800 font-extrabold text-center ';
            } else {
              cellClasses += 'bg-emerald-50/90 text-excel-700 font-extrabold text-center target-cell-highlight ';
            }
          } else if (isRef) {
            cellClasses += 'bg-amber-100/90 text-amber-900 font-extrabold text-right ring-1 ring-inset ring-amber-400 ';
          }

          if (isSelected) {
            cellClasses += 'ring-2 ring-inset ring-excel-600 z-10 ';
          }

          html += `<td onclick="selectSpreadsheetCell('${coord}')" class="${cellClasses}" title="Sel ${coord}">${displayVal}</td>`;
        });

        html += '</tr>';
      });

      html += '</tbody>';
      table.innerHTML = html;
      updateFormulaBarDisplay();
    }

    function selectSpreadsheetCell(coord) {
      selectedCellCoord = coord;
      document.getElementById('activeCellNameBox').textContent = coord;
      renderSpreadsheetGrid();
    }

    function updateFormulaBarDisplay() {
      const c = CASES_DATA[currentCaseIdx];
      const st = caseStates[currentCaseIdx];
      const bar = document.getElementById('spreadsheetFormulaDisplay');
      document.getElementById('activeCellNameBox').textContent = selectedCellCoord;

      if (!st.phase2Locked) {
        bar.innerHTML = `
          <span class="inline-flex items-center gap-1.5 text-amber-700 font-sans font-semibold">
            <i class="fa-solid fa-lock text-[11px]"></i> Selesaikan Prediksi Hasil Terlebih Dahulu
          </span>
        `;
        return;
      }

      // If unlocked, show formula if target cell selected or raw value otherwise
      if (c.targetCells.includes(selectedCellCoord)) {
        const delta = parseCellCoord(selectedCellCoord).rowIdx - parseCellCoord(c.primaryTargetCell).rowIdx;
        if (st.lastFormula) {
          const shifted = st.lastFormula.startsWith('=')
            ? '=' + shiftFormulaRows(st.lastFormula.slice(1), delta)
            : st.lastFormula;
          bar.innerHTML = `<span class="text-excel-700 font-bold">${shifted}</span>`;
        } else {
          bar.innerHTML = `<span class="text-slate-400 italic">Siap menerima formula untuk sel ${selectedCellCoord}...</span>`;
        }
      } else {
        const val = getCellValue(c.grid, selectedCellCoord);
        bar.innerHTML = `<span class="text-slate-800">${val === '' ? '(Sel Kosong)' : val}</span>`;
      }
    }

