    /**
     * ============================================================================
     * 5. RESEARCH VARIABLES COMPUTATION (3 VARIABEL PENELITIAN)
     * ============================================================================
     */
    function computeResearchScores() {
      let conceptualTotal = 0;
      let transferTotal = 0;
      let problemSolvingTotal = 0;
      let completedCount = 0;

      CASES_DATA.forEach((c, idx) => {
        const st = caseStates[idx];
        if (st.completed) completedCount++;

        // 1. Pemahaman Konseptual (25 pts per case = 100%)
        if (st.phase1Passed) {
          const penalty = Math.max(0, (st.phase1Attempts - 1) * 5);
          conceptualTotal += Math.max(10, 25 - penalty);
        }

        // 2. Transfer Belajar (Weighted: 20 + 25 + 25 + 30 = 100%)
        if (st.completed) {
          transferTotal += c.transferWeight;
        } else if (st.phase2Locked) {
          transferTotal += Math.round(c.transferWeight * 0.4);
        } else if (st.phase1Passed) {
          transferTotal += Math.round(c.transferWeight * 0.2);
        }

        // 3. Kemampuan Pemecahan Masalah (25 pts per case: 12.5 mental tracing + 12.5 debugging efficiency)
        if (st.phase2Locked) {
          problemSolvingTotal += 12.5 * st.predictionAccuracy;
        }
        if (st.completed) {
          const debugPenalty = Math.max(0, (st.phase3Attempts - 1) * 2.5);
          problemSolvingTotal += Math.max(5, 12.5 - debugPenalty);
        }
      });

      return {
        conceptual: Math.min(100, Math.round(conceptualTotal)),
        transfer: Math.min(100, Math.round(transferTotal)),
        problemSolving: Math.min(100, Math.round(problemSolvingTotal)),
        completedCount,
      };
    }

    function updateResearchMetrics() {
      const scores = computeResearchScores();

      document.getElementById('metricConceptualText').textContent = `${scores.conceptual}%`;
      document.getElementById('metricConceptualBar').style.width = `${scores.conceptual}%`;

      document.getElementById('metricTransferText').textContent = `${scores.transfer}%`;
      document.getElementById('metricTransferBar').style.width = `${scores.transfer}%`;

      document.getElementById('metricProblemText').textContent = `${scores.problemSolving}%`;
      document.getElementById('metricProblemBar').style.width = `${scores.problemSolving}%`;

      document.getElementById('headerCompletedBadge').textContent = `${scores.completedCount}/${CASES_DATA.length}`;
    }

    function getScorePredicate(score) {
      if (score >= 85) return { label: 'Sangat Baik (Mahir)', color: 'text-excel-700 bg-emerald-100' };
      if (score >= 70) return { label: 'Baik (Berkembang)', color: 'text-sky-700 bg-sky-100' };
      if (score >= 40) return { label: 'Cukup (Proses Latihan)', color: 'text-amber-700 bg-amber-100' };
      return { label: 'Awal (Belum Terukur Penuh)', color: 'text-slate-600 bg-slate-200' };
    }

