        .map((q, idx) => {
          const savedVal = st.predictions[q.id] || '';
          const isCorrect = String(savedVal).trim().toLowerCase() === String(q.correctAnswer).toLowerCase();

          let inputHtml = '';
          if (q.type === 'select') {
            inputHtml = `
              <div class="flex flex-wrap gap-2 mt-2">
                ${q.options
                  .map((opt) => {
                    const active = savedVal === opt;
                    return `
                      <button
                        type="button"
                        ${st.phase2Locked ? 'disabled' : ''}
                        onclick="setPredictionValue('${q.id}', '${opt}')"
                        class="px-4 py-2 rounded-xl font-mono text-xs sm:text-sm font-bold border transition ${
                          active
                            ? 'bg-amber-600 text-white border-amber-600 shadow-xs'
                            : 'bg-white hover:bg-amber-50 text-slate-800 border-slate-300'
                        } ${st.phase2Locked ? 'cursor-default' : 'cursor-pointer'}"
                      >
                        ${opt}
                      </button>
                    `;
                  })
                  .join('')}
              </div>
            `;
          } else {
            inputHtml = `
              <input
                type="number"
                ${st.phase2Locked ? 'disabled' : ''}
                value="${savedVal}"
                oninput="setPredictionValue('${q.id}', this.value)"
                placeholder="${q.placeholder}"
                class="mt-2 w-full sm:w-64 px-3.5 py-2 rounded-xl border border-slate-300 font-mono text-sm font-bold text-slate-900 focus:outline-none focus:border-amber-500 disabled:bg-slate-100"
              />
            `;
          }

          let reviewNote = '';
          if (st.phase2Locked) {
            reviewNote = isCorrect
              ? `<p class="mt-2 text-xs text-excel-700 font-semibold"><i class="fa-solid fa-check-circle mr-1"></i> Prediksimu akurat! (${q.explanation})</p>`
              : `<p class="mt-2 text-xs text-rose-700 font-semibold"><i class="fa-solid fa-circle-info mr-1"></i> Prediksimu: <b>${savedVal}</b> | Seharusnya: <b>${q.correctAnswer}</b> — ${q.explanation}</p>`;
          }

          return `
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <label class="block text-xs sm:text-sm font-semibold text-slate-800">
                ${idx + 1}. ${q.label}
              </label>
              ${inputHtml}
              ${reviewNote}
            </div>
          `;
        })
        .join('');

      const lockBtn = document.getElementById('btnLockPrediction');
      if (st.phase2Locked) {
        lockBtn.classList.add('hidden');
        feedback.classList.remove('hidden');
        const pct = Math.round(st.predictionAccuracy * 100);
        feedback.className = 'rounded-xl p-3.5 text-xs sm:text-sm bg-sky-50 border border-sky-200 text-sky-950 flex items-start gap-2.5';
        feedback.innerHTML = `
          <i class="fa-solid fa-unlock-keyhole text-sky-600 text-base mt-0.5"></i>
          <div>
            <strong>Prediksi Dikunci (Akurasi Tracing: ${pct}%)!</strong> Editor Formula Excel pada <b>Tahap 3</b> kini sudah terbuka. Buktikan prediksimu dengan mengetik rumusnya!
          </div>
        `;
      } else {
        lockBtn.classList.remove('hidden');
        feedback.classList.add('hidden');
      }
    }

    function setPredictionValue(qId, val) {
      caseStates[currentCaseIdx].predictions[qId] = val;
      // Re-render only if button select type so input focus isn't lost
      const q = CASES_DATA[currentCaseIdx].predictions.find((item) => item.id === qId);
      if (q && q.type === 'select') {
        renderPhase2();
      }
    }

    function lockPredictions() {
      const c = CASES_DATA[currentCaseIdx];
      const st = caseStates[currentCaseIdx];
      const feedback = document.getElementById('phase2Feedback');

      // Ensure all predictions are filled
      for (const q of c.predictions) {
        const val = st.predictions[q.id];
        if (val === undefined || String(val).trim() === '') {
          feedback.classList.remove('hidden');
          feedback.className = 'rounded-xl p-3.5 text-xs sm:text-sm bg-rose-50 border border-rose-200 text-rose-900';
          feedback.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1.5 text-rose-600"></i> Lengkapi semua kolom prediksi hasil di atas sebelum membuka editor rumus Excel.';
          return;
        }
      }

      // Calculate prediction accuracy
      let correctCount = 0;
      c.predictions.forEach((q) => {
        if (String(st.predictions[q.id]).trim().toLowerCase() === String(q.correctAnswer).toLowerCase()) {
          correctCount++;
        }
      });

      st.predictionAccuracy = correctCount / c.predictions.length;
      st.phase2Locked = true;

      logActivity(
        'Tahap 2 (Predict)',
        c.code,
        `Mengunci prediksi mental tracing (Akurasi: ${Math.round(st.predictionAccuracy * 100)}%)`,
        st.predictionAccuracy === 1 ? 'success' : 'warn'
      );

      renderPhase2();
      renderPhase3();
      updateFormulaBarDisplay();
      updateResearchMetrics();
    }

    /**
     * -------------------- PHASE 3: FORMULA TESTING & DEBUGGING --------------------
     */
    function renderPhase3() {
      const c = CASES_DATA[currentCaseIdx];
      const st = caseStates[currentCaseIdx];

      const card = document.getElementById('phase3Card');
      const num = document.getElementById('phase3Number');
      const badge = document.getElementById('phase3Badge');
      const lockedOverlay = document.getElementById('phase3LockedOverlay');
