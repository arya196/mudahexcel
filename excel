      body.classList.remove('hidden');

      if (st.completed) {
        card.className = 'bg-white rounded-2xl border-2 border-excel-600 shadow-sm overflow-hidden transition-all';
        num.className = 'w-8 h-8 rounded-xl bg-excel-600 text-white font-extrabold text-sm flex items-center justify-center';
