    /**
     * ============================================================================
     * 3. BUILT-IN JAVASCRIPT EXCEL FORMULA EVALUATOR ENGINE
     * ============================================================================
     */
    function colLetterToIndex(colStr) {
      let idx = 0;
      const clean = colStr.replace(/\$/g, '').toUpperCase();
      for (let i = 0; i < clean.length; i++) {
        idx = idx * 26 + (clean.charCodeAt(i) - 64);
      }
      return idx - 1;
    }

    function parseCellCoord(coordStr) {
      const match = coordStr.trim().match(/^(\$?)([A-Za-z]+)(\$?)(\d+)$/);
      if (!match) return null;
      return {
        colLocked: match[1] === '$',
        colStr: match[2].toUpperCase(),
        colIdx: colLetterToIndex(match[2]),
        rowLocked: match[3] === '$',
        rowNum: parseInt(match[4], 10),
        rowIdx: parseInt(match[4], 10) - 1,
      };
    }

    function getCellValue(grid, coordStr) {
      const parsed = parseCellCoord(coordStr);
      if (!parsed) return '#REF!';
      if (parsed.rowIdx < 0 || parsed.rowIdx >= grid.length) return '';
      const row = grid[parsed.rowIdx];
      if (!row || parsed.colIdx < 0 || parsed.colIdx >= row.length) return '';
      return row[parsed.colIdx];
    }

    function expandRange(grid, rangeStr) {
      const parts = rangeStr.split(':');
      if (parts.length !== 2) return null;
      const start = parseCellCoord(parts[0]);
      const end = parseCellCoord(parts[1]);
      if (!start || !end) return null;

      const rMin = Math.min(start.rowIdx, end.rowIdx);
      const rMax = Math.max(start.rowIdx, end.rowIdx);
      const cMin = Math.min(start.colIdx, end.colIdx);
      const cMax = Math.max(start.colIdx, end.colIdx);

      const values = [];
      for (let r = rMin; r <= rMax; r++) {
        for (let c = cMin; c <= cMax; c++) {
          const val = grid[r] && grid[r][c] !== undefined ? grid[r][c] : '';
          values.push(val);
        }
      }
      return values;
    }

    /**
     * Simulates Excel Autofill row shifting (respecting $ absolute row locks)
     */
    function shiftFormulaRows(formula, rowDelta) {
      if (rowDelta === 0) return formula;
      // Replace cell references outside double quotes
      let inQuotes = false;
      let result = '';
      let buffer = '';

      for (let i = 0; i < formula.length; i++) {
        const ch = formula[i];
        if (ch === '"') {
          if (!inQuotes) {
            // Flush non-quoted buffer
            result += shiftRefsInSegment(buffer, rowDelta);
            buffer = '';
            inQuotes = true;
            result += ch;
          } else {
            inQuotes = false;
            result += ch;
          }
        } else if (inQuotes) {
          result += ch;
        } else {
          buffer += ch;
        }
      }
      if (buffer) {
        result += shiftRefsInSegment(buffer, rowDelta);
      }
      return result;
    }

    function shiftRefsInSegment(segment, rowDelta) {
      return segment.replace(/(\$?)([A-Za-z]{1,2})(\$?)(\d+)/g, (match, cLock, col, rLock, rowStr) => {
        if (rLock === '$') {
          return `${cLock}${col}$${rowStr}`;
        }
        const newRow = parseInt(rowStr, 10) + rowDelta;
        return `${cLock}${col}${newRow}`;
      });
    }

    /**
     * Splits function arguments by top-level ',' or ';' ignoring quotes & nested parens
     */
    function splitTopLevelArgs(argString) {
      const args = [];
      let current = '';
      let depth = 0;
      let inQuotes = false;

      for (let i = 0; i < argString.length; i++) {
        const ch = argString[i];
        if (ch === '"') {
          inQuotes = !inQuotes;
          current += ch;
        } else if (!inQuotes) {
          if (ch === '(') {
            depth++;
            current += ch;
          } else if (ch === ')') {
            depth--;
            current += ch;
          } else if ((ch === ',' || ch === ';') && depth === 0) {
            args.push(current.trim());
            current = '';
          } else {
            current += ch;
          }
        } else {
          current += ch;
        }
      }
      if (current.trim() !== '' || args.length > 0) {
        args.push(current.trim());
      }
      return args.filter((a) => a !== '');
    }

    function evaluateSingleValue(expr, grid) {
      const trimmed = expr.trim();
      if (trimmed === '') return '';

      // Quoted string literal
      if (trimmed.startsWith('"') && trimmed.endsWith('"') && trimmed.length >= 2) {
        return trimmed.slice(1, -1);
      }

      // Numeric literal
      if (!isNaN(Number(trimmed))) {
        return Number(trimmed);
      }

      // Nested function call
      if (/^[A-Za-z]+\s*\(.*\)$/.test(trimmed)) {
        return evaluateExpression(trimmed, grid);
      }

      // Cell reference
      if (/^\$?[A-Za-z]+\$?\d+$/.test(trimmed)) {
        const val = getCellValue(grid, trimmed);
        return val === '' ? 0 : val; // In arithmetic/comparisons, empty cell evaluates as 0 in Excel
      }

      return trimmed;
    }

    function matchesCriteria(cellVal, rawCriteria) {
      let crit = rawCriteria.trim();
      if (crit.startsWith('"') && crit.endsWith('"')) {
        crit = crit.slice(1, -1);
      }

      // Check operator prefix in criteria (e.g., ">=10", "<100")
      const opMatch = crit.match(/^(>=|<=|<>|!=|>|<|=)(.*)$/);
      if (opMatch) {
        const op = opMatch[1];
        const rhsRaw = opMatch[2].trim();
        const rhsNum = Number(rhsRaw);
        const lhsNum = cellVal === '' ? 0 : Number(cellVal);

        if (!isNaN(rhsNum) && !isNaN(lhsNum)) {
          if (op === '>=') return lhsNum >= rhsNum;
          if (op === '<=') return lhsNum <= rhsNum;
          if (op === '>') return lhsNum > rhsNum;
          if (op === '<') return lhsNum < rhsNum;
          if (op === '=') return lhsNum === rhsNum;
          if (op === '<>' || op === '!=') return lhsNum !== rhsNum;
        }
      }

      // Exact match (case-insensitive for strings)
      if (typeof cellVal === 'string') {
        return cellVal.toLowerCase() === crit.toLowerCase();
      }
      if (!isNaN(Number(crit)) && crit !== '') {
        return Number(cellVal) === Number(crit);
      }
      return String(cellVal).toLowerCase() === crit.toLowerCase();
    }

    function evaluateLogicalTest(testExpr, grid) {
      // Find comparison operator outside quotes
      let inQuotes = false;
      let opIndex = -1;
      let opFound = '';

      const operators = ['>=', '<=', '<>', '!=', '=', '>', '<'];
      for (let i = 0; i < testExpr.length; i++) {
        if (testExpr[i] === '"') {
          inQuotes = !inQuotes;
          continue;
        }
        if (!inQuotes) {
          for (const op of operators) {
            if (testExpr.slice(i, i + op.length) === op) {
              opIndex = i;
              opFound = op;
              break;
            }
          }
          if (opIndex !== -1) break;
        }
      }

      if (opIndex === -1) {
        const val = evaluateSingleValue(testExpr, grid);
        return Boolean(val);
      }

      const lhsExpr = testExpr.slice(0, opIndex).trim();
      const rhsExpr = testExpr.slice(opIndex + opFound.length).trim();

      const lhs = evaluateSingleValue(lhsExpr, grid);
      const rhs = evaluateSingleValue(rhsExpr, grid);

      const bothNumeric = typeof lhs === 'number' && typeof rhs === 'number';
      if (bothNumeric) {
        switch (opFound) {
          case '>=': return lhs >= rhs;
          case '<=': return lhs <= rhs;
          case '>': return lhs > rhs;
          case '<': return lhs < rhs;
          case '=': return lhs === rhs;
          case '<>':
          case '!=': return lhs !== rhs;
        }
      } else {
        const lStr = String(lhs).toLowerCase();
        const rStr = String(rhs).toLowerCase();
        switch (opFound) {
          case '=': return lStr === rStr;
          case '<>':
          case '!=': return lStr !== rStr;
          case '>=': return lStr >= rStr;
          case '<=': return lStr <= rStr;
          case '>': return lStr > rStr;
          case '<': return lStr < rStr;
        }
      }
      return false;
    }

    function collectValuesFromArgs(args, grid) {
      const items = [];
      for (const arg of args) {
        if (arg.includes(':')) {
          const expanded = expandRange(grid, arg);
          if (!expanded) throw new Error('#REF!');
          items.push(...expanded);
        } else if (/^\$?[A-Za-z]+\$?\d+$/.test(arg)) {
          items.push(getCellValue(grid, arg));
        } else {
          items.push(evaluateSingleValue(arg, grid));
        }
      }
      return items;
    }

    function evaluateExpression(expr, grid) {
      const trimmed = expr.trim();

      // Check basic arithmetic division like =SUM(C2:C6)/5
      const divMatch = trimmed.match(/^([A-Za-z]+\s*\([^()]*\))\s*\/\s*(\d+(?:\.\d+)?)$/);
      if (divMatch) {
        const num = evaluateExpression(divMatch[1], grid);
        const den = Number(divMatch[2]);
        if (den === 0) return '#DIV/0!';
        if (typeof num === 'number') return Number((num / den).toFixed(4));
      }

      const fnMatch = trimmed.match(/^([A-Za-z]+)\s*\((.*)\)$/);
      if (!fnMatch) {
        return evaluateSingleValue(trimmed, grid);
      }

      const fnName = fnMatch[1].toUpperCase();
      const args = splitTopLevelArgs(fnMatch[2]);

      switch (fnName) {
        case 'SUM': {
          const vals = collectValuesFromArgs(args, grid);
          return vals.reduce((acc, v) => (typeof v === 'number' ? acc + v : acc), 0);
        }
        case 'AVERAGE': {
          const vals = collectValuesFromArgs(args, grid);
          const nums = vals.filter((v) => typeof v === 'number');
          if (nums.length === 0) return '#DIV/0!';
          const sum = nums.reduce((a, b) => a + b, 0);
          return Number((sum / nums.length).toFixed(4));
        }
        case 'COUNT': {
          const vals = collectValuesFromArgs(args, grid);
          return vals.filter((v) => typeof v === 'number').length;
        }
        case 'COUNTA': {
          const vals = collectValuesFromArgs(args, grid);
          return vals.filter((v) => v !== '' && v !== null && v !== undefined).length;
        }
        case 'MIN': {
          const vals = collectValuesFromArgs(args, grid).filter((v) => typeof v === 'number');
          return vals.length ? Math.min(...vals) : 0;
        }
        case 'MAX': {
          const vals = collectValuesFromArgs(args, grid).filter((v) => typeof v === 'number');
          return vals.length ? Math.max(...vals) : 0;
        }
        case 'COUNTIF': {
          if (args.length < 2) return '#VALUE!';
          const rangeVals = expandRange(grid, args[0]);
          if (!rangeVals) return '#REF!';
          return rangeVals.filter((v) => matchesCriteria(v, args[1])).length;
        }
        case 'SUMIF': {
          if (args.length < 2) return '#VALUE!';
          const critVals = expandRange(grid, args[0]);
          if (!critVals) return '#REF!';
          const sumVals = args[2] ? expandRange(grid, args[2]) : critVals;
          if (!sumVals) return '#REF!';

          let total = 0;
          const len = Math.min(critVals.length, sumVals.length);
          for (let i = 0; i < len; i++) {
            if (matchesCriteria(critVals[i], args[1]) && typeof sumVals[i] === 'number') {
              total += sumVals[i];
            }
          }
          return total;
        }
        case 'IF': {
          if (args.length < 2) return '#VALUE!';
          const cond = evaluateLogicalTest(args[0], grid);
          if (cond) {
            return evaluateSingleValue(args[1], grid);
          } else {
            return args[2] !== undefined ? evaluateSingleValue(args[2], grid) : false;
          }
        }
        default:
          return '#NAME?';
      }
    }

    function runExcelFormula(rawInput, grid, rowDelta = 0) {
      const clean = rawInput.trim();
      if (!clean.startsWith('=')) {
        return { error: 'MISSING_EQUALS', value: clean };
      }

      // Check balanced parentheses
      let balance = 0;
      let inQuotes = false;
      for (const ch of clean) {
        if (ch === '"') inQuotes = !inQuotes;
        if (!inQuotes) {
          if (ch === '(') balance++;
          if (ch === ')') balance--;
        }
      }
      if (balance !== 0) {
        return { error: 'PAREN_MISMATCH', value: '#ERROR!' };
      }

      try {
        const shifted = shiftFormulaRows(clean.slice(1), rowDelta);
        const result = evaluateExpression(shifted, grid);
        if (typeof result === 'string' && result.startsWith('#')) {
          return { error: result, value: result, shiftedFormula: '=' + shifted };
        }
        return { error: null, value: result, shiftedFormula: '=' + shifted };
      } catch (err) {
        return { error: err.message || '#ERROR!', value: '#ERROR!' };
      }
    }

