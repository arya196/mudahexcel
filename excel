      renderPhase1();
    }

    function verifyPhase1() {
      const c = CASES_DATA[currentCaseIdx];
      const st = caseStates[currentCaseIdx];
      const feedback = document.getElementById('phase1Feedback');

      if (!st.selectedFunc || !st.selectedReasonId) {
        feedback.classList.remove('hidden');
        feedback.className = 'rounded-xl p-3.5 text-xs sm:text-sm bg-amber-50 border border-amber-200 text-amber-900';
        feedback.innerHTML = '<i class="fa-solid fa-circle-info mr-1.5 text-amber-600"></i> Pilih <b>fungsi Excel</b> pada Langkah 1A dan <b>alasan logisnya</b> pada Langkah 1B terlebih dahulu.';
        return;
      }

      st.phase1Attempts++;
      document.getElementById('phase1AttemptsText').textContent = `Percobaan diagnosa: ${st.phase1Attempts} kali`;

      const chosenReason = c.reasonOptions.find((r) => r.id === st.selectedReasonId);
      const isFuncCorrect = st.selectedFunc === c.correctFunction;
      const isReasonCorrect = chosenReason && chosenReason.isCorrect;

      if (isFuncCorrect && isReasonCorrect) {
        st.phase1Passed = true;
        logActivity('Tahap 1 (Select)', c.code, `Berhasil memilih ${c.correctFunction} & alasan logis (Percobaan ke-${st.phase1Attempts})`, 'success');
        renderPhase1();
        renderPhase2();
        updateResearchMetrics();
      } else {
        let diagMsg = '';
        if (!isFuncCorrect && !isReasonCorrect) {
          diagMsg = `Pilihan fungsi <code>${st.selectedFunc}</code> dan alasannya belum sesuai dengan kebutuhan masalah. ${chosenReason.hint}`;
        } else if (!isFuncCorrect) {
          diagMsg = `Alasanmu sudah mengarah ke logika yang tepat, tetapi nama fungsi <code>${st.selectedFunc}</code> kurang sesuai. Coba cocokan kembali karakter fungsi dengan misi soal!`;
        } else {
          diagMsg = `Fungsi <code>${st.selectedFunc}</code> sudah tepat, tetapi alasan pada Langkah 1B masih mengandung miskonsepsi: ${chosenReason.hint}`;
        }

        if (!st.trapsHit.includes('Phase1_Misconception')) {
          st.trapsHit.push('Phase1_Misconception');
        }
        logActivity('Tahap 1 (Select)', c.code, `Percobaan ke-${st.phase1Attempts} keliru (${st.selectedFunc})`, 'warn');

        feedback.classList.remove('hidden');
        feedback.className = 'rounded-xl p-3.5 text-xs sm:text-sm bg-rose-50 border border-rose-200 text-rose-900 flex items-start gap-2.5 fade-in';
        feedback.innerHTML = `
          <i class="fa-solid fa-circle-xmark text-rose-600 text-base mt-0.5"></i>
          <div><strong>Belum Tepat — Tinjau Kembali Logikanya:</strong><br/>${diagMsg}</div>
        `;
        updateResearchMetrics();
      }
    }

