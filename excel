        num.className = 'w-8 h-8 rounded-xl bg-sky-600 text-white font-extrabold text-sm flex items-center justify-center';
        badge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-sky-100 text-sky-800';
        badge.innerHTML = '<i class="fa-solid fa-unlock mr-1"></i> Sandbox Aktif';
