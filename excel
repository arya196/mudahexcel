          nextBtn.innerHTML = '<i class="fa-solid fa-chart-line"></i><span>Lihat Rapor & Log Kognitif</span>';
        } else {
          nextBtn.innerHTML = '<span>Lanjut ke Kasus Berikutnya</span><i class="fa-solid fa-arrow-right"></i>';
        }
      } else {
        nextContainer.classList.add('hidden');
      }
