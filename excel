    function renderComparisonAndDiagnostics(syntaxErrorType = null, allMatched = false) {
      const c = CASES_DATA[currentCaseIdx];
      const st = caseStates[currentCaseIdx];

      const compSection = document.getElementById('comparisonSection');
      const compBody = document.getElementById('comparisonTableBody');
      const diagBox = document.getElementById('phase3DiagnosticBox');

      compSection.classList.remove('hidden');
      document.getElementById('phase3AttemptsBadge').textContent = `Uji ke-${st.phase3Attempts}`;

      // Build comparison rows
      compBody.innerHTML = c.comparisonSamples
        .map((sample) => {
          const userPred = sample.predictionKey ? st.predictions[sample.predictionKey] : '(Otomatis Autofill)';
          const actualVal = st.evaluatedCells[sample.cell];
          const isRowOk = String(actualVal).toLowerCase() === String(sample.expected).toLowerCase();

          return `
            <tr class="${isRowOk ? 'bg-emerald-50/40' : 'bg-rose-50/50'}">
              <td class="py-2.5 px-3.5 font-semibold text-slate-800">${sample.label}</td>
              <td class="py-2.5 px-3.5 font-mono text-amber-700 font-bold">${userPred}</td>
              <td class="py-2.5 px-3.5 font-mono font-extrabold ${isRowOk ? 'text-excel-700' : 'text-rose-700'}">${actualVal}</td>
              <td class="py-2.5 px-3.5 font-mono text-slate-600">${sample.expected}</td>
              <td class="py-2.5 px-3.5 text-center">
                ${
                  isRowOk
                    ? '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-excel-800"><i class="fa-solid fa-check"></i> Cocok</span>'
                    : '<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-800"><i class="fa-solid fa-xmark"></i> Meleset</span>'
                }
              </td>
            </tr>
          `;
        })
        .join('');

      // Check completion state if re-rendering
      const checkAllOk = c.targetCells.every(
        (coord) => String(st.evaluatedCells[coord]).toLowerCase() === String(c.expectedOutputs[coord]).toLowerCase()
      );

      diagBox.classList.remove('hidden');

      if (checkAllOk && !syntaxErrorType) {
        diagBox.className = 'rounded-xl p-4 text-xs sm:text-sm bg-emerald-50 border border-emerald-300 text-emerald-950 flex items-start gap-3 fade-in';
        diagBox.innerHTML = `
          <div class="w-8 h-8 rounded-lg bg-excel-600 text-white flex items-center justify-center shrink-0 mt-0.5">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <div>
            <h4 class="font-extrabold text-excel-800 text-sm">Luar Biasa! Formula Terbukti Valid di Semua Sel Target</h4>
            <p class="mt-1">
              Formula <code class="font-mono font-bold bg-white px-1.5 py-0.5 rounded border border-emerald-200">${st.lastFormula}</code> berhasil dievaluasi dan cocok dengan perilaku Microsoft Excel sesungguhnya. Transfer pengetahuanmu pada kasus <b>${c.level}</b> telah teruji!
            </p>
          </div>
        `;
        return;
      }

      // Syntax-level diagnostic first
      if (syntaxErrorType === 'MISSING_EQUALS') {
        diagBox.className = 'rounded-xl p-4 text-xs sm:text-sm bg-amber-50 border border-amber-300 text-amber-950 flex items-start gap-3 fade-in';
        diagBox.innerHTML = `
          <i class="fa-solid fa-triangle-exclamation text-amber-600 text-lg mt-0.5"></i>
          <div>
            <h4 class="font-extrabold text-amber-900">Kesalahan Sintaks Awal: Lupa Tanda Sama Dengan (=)</h4>
            <p class="mt-1">Tanpa diawali tanda <code>=</code>, Excel menganggap ketikanmu sebagai teks biasa, bukan rumus perhitungan. Tambahkan <code>=</code> di paling depan!</p>
          </div>
        `;
        return;
      }

      if (syntaxErrorType === 'PAREN_MISMATCH') {
        diagBox.className = 'rounded-xl p-4 text-xs sm:text-sm bg-rose-50 border border-rose-300 text-rose-950 flex items-start gap-3 fade-in';
        diagBox.innerHTML = `
          <i class="fa-solid fa-code text-rose-600 text-lg mt-0.5"></i>
          <div>
            <h4 class="font-extrabold text-rose-900">Kesalahan Sintaks: Kurung Buka & Tutup Tidak Seimbang</h4>
            <p class="mt-1">Periksa kembali jumlah tanda kurung buka <code>(</code> dan kurung tutup <code>)</code> pada formulamu.</p>
          </div>
        `;
        return;
      }

      if (syntaxErrorType === '#NAME?') {
        diagBox.className = 'rounded-xl p-4 text-xs sm:text-sm bg-rose-50 border border-rose-300 text-rose-950 flex items-start gap-3 fade-in';
        diagBox.innerHTML = `
          <i class="fa-solid fa-spell-check text-rose-600 text-lg mt-0.5"></i>
          <div>
            <h4 class="font-extrabold text-rose-900">Galat Excel #NAME? — Nama Fungsi Tidak Dikenali</h4>
            <p class="mt-1">Periksa ejaan nama fungsi Excel yang kamu ketik (misalnya <code>COUNTA</code>, <code>AVERAGE</code>, <code>SUMIF</code>, atau <code>IF</code>).</p>
          </div>
        `;
        return;
      }

      // Case-specific Trap / Conceptual Diagnostics
      const customDiag = c.diagnoseFormula(st.lastFormula, st.evaluatedCells);
      if (customDiag) {
        if (!st.trapsHit.includes(customDiag.title)) {
          st.trapsHit.push(customDiag.title);
        }
        diagBox.className = 'rounded-xl p-4 text-xs sm:text-sm bg-rose-50 border border-rose-300 text-rose-950 flex items-start gap-3 fade-in';
        diagBox.innerHTML = `
          <i class="fa-solid fa-magnifying-glass-chart text-rose-600 text-lg mt-0.5"></i>
          <div>
            <h4 class="font-extrabold text-rose-900">${customDiag.title}</h4>
            <p class="mt-1">${customDiag.message}</p>
          </div>
        `;
        return;
      }

      // General fallback diagnostic
      diagBox.className = 'rounded-xl p-4 text-xs sm:text-sm bg-rose-50 border border-rose-300 text-rose-950 flex items-start gap-3 fade-in';
      diagBox.innerHTML = `
        <i class="fa-solid fa-bug text-rose-600 text-lg mt-0.5"></i>
        <div>
          <h4 class="font-extrabold text-rose-900">Hasil Aktual Belum Sesuai Target — Lakukan Debugging!</h4>
          <p class="mt-1">Bandingkan kolom <b>Hasil Aktual Rumusmu</b> dengan <b>Kunci Seharusnya</b> pada tabel di atas. Periksa kembali rentang sel, kriteria teks (gunakan tanda petik ganda <code>"..."</code>), atau operator perbandingan yang dipakai.</p>
        </div>
      `;
    }

