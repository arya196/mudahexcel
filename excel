        statusPill.innerHTML = '<i class="fa-solid fa-check-circle mr-1"></i> Tuntas';
      } else {
        statusPill.className = 'shrink-0 px-3 py-1 rounded-full text-xs font-bold bg-amber-400/20 text-amber-100 border border-amber-300/30';
