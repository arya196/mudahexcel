            <td class="py-2.5 px-3">
              <div class="font-bold text-slate-800">${c.code}: ${c.title}</div>
              <div class="text-[11px] text-slate-500">${c.level}</div>
            </td>
            <td class="py-2.5 px-3">
              ${
                st.completed
                  ? '<span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-excel-800">Tuntas</span>'
                  : '<span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-600">Proses</span>'
              }
            </td>
            <td class="py-2.5 px-3 text-center font-mono">${st.phase1Attempts}x</td>
            <td class="py-2.5 px-3 text-center font-mono font-bold">${predPct}</td>
            <td class="py-2.5 px-3 text-center font-mono">${st.phase3Attempts}x</td>
            <td class="py-2.5 px-3 font-mono text-[11px] text-slate-700">${st.lastFormula || '-'}</td>
          </tr>
        `;
      }).join('');

      // Render Cognitive Logs
      document.getElementById('logCountBadge').textContent = `${cognitiveLogs.length} aktivitas`;
      const logContainer = document.getElementById('cognitiveLogList');
      if (cognitiveLogs.length === 0) {
        logContainer.innerHTML = '<div class="text-slate-500 italic">Belum ada aktivitas terekam. Mulai kerjakan Tahap 1 pada studi kasus!</div>';
      } else {
        logContainer.innerHTML = cognitiveLogs
          .map((item) => {
            const color =
              item.status === 'success'
                ? 'text-emerald-400'
                : item.status === 'error'
                ? 'text-rose-400'
                : 'text-amber-300';
            return `<div><span class="text-slate-500">[${item.time}]</span> <span class="text-sky-400">[${item.caseCode} • ${item.phase}]</span> <span class="${color}">${item.detail}</span></div>`;
          })
          .join('');
      }

      document.getElementById('copySuccessBanner').classList.add('hidden');
      document.getElementById('reportModal').classList.remove('hidden');
    }

    function closeReportModal() {
      document.getElementById('reportModal').classList.add('hidden');
    }

    function copyReportSummary() {
      const scores = computeResearchScores();
      const name = document.getElementById('studentNameInput').value || 'Siswa';
      const cls = document.getElementById('studentClassInput').value || '-';

      let text = `=== RAPOR CAPAIAN EXCEL FUNCTION CHALLENGE ===\n`;
      text += `Nama Peserta Didik : ${name}\n`;
      text += `Kelas / Kelompok   : ${cls}\n`;
      text += `Kasus Tuntas       : ${scores.completedCount} dari ${CASES_DATA.length}\n\n`;
      text += `SKOR VARIABEL PENELITIAN:\n`;
      text += `- Pemahaman Konseptual        : ${scores.conceptual}%\n`;
      text += `- Transfer Belajar            : ${scores.transfer}%\n`;
      text += `- Kemampuan Pemecahan Masalah : ${scores.problemSolving}%\n\n`;
      text += `RINCIAN PER KASUS:\n`;
      CASES_DATA.forEach((c, idx) => {
        const st = caseStates[idx];
        text += `${idx + 1}. ${c.title} [${c.level}] -> Status: ${st.completed ? 'Tuntas' : 'Belum'} | Formula: ${st.lastFormula || '-'}\n`;
      });

      const tempArea = document.createElement('textarea');
      tempArea.value = text;
      document.body.appendChild(tempArea);
      tempArea.select();
      document.execCommand('copy');
      document.body.removeChild(tempArea);

      document.getElementById('copySuccessBanner').classList.remove('hidden');
    }

    function openConfirmDialog(title, message, onProceed) {
      document.getElementById('confirmDialogTitle').textContent = title;
      document.getElementById('confirmDialogMessage').textContent = message;
      pendingConfirmAction = onProceed;
      document.getElementById('confirmDialogProceedBtn').onclick = () => {
        if (pendingConfirmAction) pendingConfirmAction();
        closeConfirmDialog();
      };
      document.getElementById('confirmDialogModal').classList.remove('hidden');
    }

    function closeConfirmDialog() {
      document.getElementById('confirmDialogModal').classList.add('hidden');
      pendingConfirmAction = null;
    }

    function confirmResetCurrentCase() {
      const c = CASES_DATA[currentCaseIdx];
      openConfirmDialog(
        `Reset ${c.code}?`,
        `Seluruh jawaban Tahap 1, Tahap 2, dan Tahap 3 pada "${c.title}" akan dikembalikan ke awal.`,
        () => {
          caseStates[currentCaseIdx] = {
            selectedFunc: null,
            selectedReasonId: null,
            phase1Attempts: 0,
            phase1Passed: false,
            predictions: {},
            phase2Locked: false,
            predictionAccuracy: 0,
            phase3Attempts: 0,
            lastFormula: '',
            evaluatedCells: {},
            completed: false,
            trapsHit: [],
          };
          logActivity('Reset', c.code, 'Mereset ulang seluruh tahapan pada kasus ini', 'warn');
          loadCase(currentCaseIdx);
          updateResearchMetrics();
        }
      );
    }

    function resetAllProgress() {
      openConfirmDialog(
        'Reset Seluruh Sesi Pembelajaran?',
        'Semua progres dari Kasus 1 sampai Kasus 4 beserta log kognitif akan dihapus.',
        () => {
          for (let i = 0; i < caseStates.length; i++) {
            caseStates[i] = {
              selectedFunc: null,
              selectedReasonId: null,
              phase1Attempts: 0,
              phase1Passed: false,
              predictions: {},
              phase2Locked: false,
              predictionAccuracy: 0,
              phase3Attempts: 0,
              lastFormula: '',
              evaluatedCells: {},
              completed: false,
              trapsHit: [],
            };
          }
          cognitiveLogs.length = 0;
          closeReportModal();
          loadCase(0);
          updateResearchMetrics();
        }
      );
    }

    // Boot application on load
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
