<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Excel Function Challenge — Pembelajaran Berbasis Kasus</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            excel: {
              50: '#ecfdf5',
              100: '#d1fae5',
              200: '#a7f3d0',
              500: '#10b981',
              600: '#107c41',
              700: '#0b5c30',
              800: '#064e3b',
              900: '#022c22',
            },
          },
        },
      },
    };
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }

    /* Custom subtle grid & scrollbars */
    .excel-grid-scroll::-webkit-scrollbar {
      height: 8px;
      width: 8px;
    }
    .excel-grid-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }
    .excel-grid-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .excel-grid-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Smooth pulse for target cells */
    @keyframes targetPulse {
      0%, 100% {
        box-shadow: inset 0 0 0 2px #107c41;
      }
      50% {
        box-shadow: inset 0 0 0 2px #f59e0b;
      }
    }
    .target-cell-highlight {
      animation: targetPulse 2.4s infinite ease-in-out;
    }

    /* Fade slide transition */
    .fade-in {
      animation: fadeIn 0.3s ease-out forwards;
    }
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-emerald-200 selection:text-emerald-900">

  <!-- ==================== TOP HEADER & RESEARCH METRICS ==================== -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <!-- Top Row: Brand & Action Buttons -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-excel-600 to-excel-700 text-white flex items-center justify-center shadow-md shadow-emerald-900/15 shrink-0">
            <i class="fa-solid fa-table-cells text-xl"></i>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-slate-900">
                Excel Function Challenge
              </h1>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-excel-700 border border-emerald-200">
                <i class="fa-solid fa-flask text-[10px]"></i> Riset Transfer Belajar
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">
              Pembelajaran Berbasis Kasus: <span class="text-excel-600 font-semibold">Select</span> <i class="fa-solid fa-arrow-right text-[10px] mx-0.5 text-slate-400"></i> <span class="text-amber-600 font-semibold">Predict</span> <i class="fa-solid fa-arrow-right text-[10px] mx-0.5 text-slate-400"></i> <span class="text-sky-600 font-semibold">Test</span>
            </p>
          </div>
        </div>

        <!-- Utility Buttons -->
        <div class="flex items-center gap-2.5 flex-wrap">
          <button
            type="button"
            onclick="openSyntaxModal()"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200/80 border border-slate-200 transition active:scale-[0.99]"
          >
            <i class="fa-solid fa-book-open text-excel-600"></i>
            <span>Contoh Format Penulisan</span>
          </button>

          <button
            type="button"
            onclick="openReportModal()"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-excel-600 hover:bg-excel-700 shadow-sm shadow-emerald-900/15 transition active:scale-[0.99]"
          >
            <i class="fa-solid fa-chart-line"></i>
            <span>Rapor & Log Kognitif</span>
            <span id="headerCompletedBadge" class="ml-0.5 px-1.5 py-0.2 rounded-md bg-white/20 text-[11px] font-mono">0/4</span>
          </button>
        </div>
      </div>

      <!-- Bottom Row: 3 Live Research Variable Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3.5 pt-3.5 border-t border-slate-100">
        <!-- Variabel 1: Pemahaman Konseptual -->
        <div class="bg-slate-50/90 border border-slate-200/80 rounded-xl p-2.5 sm:p-3 flex flex-col justify-between">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-emerald-100 text-excel-700 flex items-center justify-center text-xs">
                <i class="fa-solid fa-brain"></i>
              </span>
              <div>
                <h2 class="text-xs font-bold text-slate-800 leading-tight">Pemahaman Konseptual</h2>
                <p class="text-[11px] text-slate-500">Diagnosa fungsi & alasan logis (Two-Tier)</p>
              </div>
            </div>
            <span id="metricConceptualText" class="text-sm font-extrabold font-mono text-excel-700">0%</span>
          </div>
          <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
            <div id="metricConceptualBar" class="h-full bg-excel-600 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Variabel 2: Transfer Belajar -->
        <div class="bg-slate-50/90 border border-slate-200/80 rounded-xl p-2.5 sm:p-3 flex flex-col justify-between">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-xs">
                <i class="fa-solid fa-shuffle"></i>
              </span>
              <div>
                <h2 class="text-xs font-bold text-slate-800 leading-tight">Transfer Belajar</h2>
                <p class="text-[11px] text-slate-500">Adaptasi Near → Far Transfer & Trap</p>
              </div>
            </div>
            <span id="metricTransferText" class="text-sm font-extrabold font-mono text-amber-600">0%</span>
          </div>
          <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
            <div id="metricTransferBar" class="h-full bg-amber-500 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Variabel 3: Kemampuan Pemecahan Masalah -->
        <div class="bg-slate-50/90 border border-slate-200/80 rounded-xl p-2.5 sm:p-3 flex flex-col justify-between">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center text-xs">
                <i class="fa-solid fa-bug-slash"></i>
              </span>
              <div>
                <h2 class="text-xs font-bold text-slate-800 leading-tight">Pemecahan Masalah</h2>
                <p class="text-[11px] text-slate-500">Mental tracing & efisiensi debugging</p>
              </div>
            </div>
            <span id="metricProblemText" class="text-sm font-extrabold font-mono text-sky-600">0%</span>
          </div>
          <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">
            <div id="metricProblemBar" class="h-full bg-sky-600 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ==================== CASE NAVIGATION STEPPER ==================== -->
  <nav class="bg-slate-100/80 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2.5">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
          <i class="fa-solid fa-layer-group text-excel-600"></i> Pilih Studi Kasus Berjenjang:
        </span>
        <button
          type="button"
          onclick="confirmResetCurrentCase()"
          class="self-start sm:self-auto inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition"
        >
          <i class="fa-solid fa-rotate-left"></i> Reset Kasus Ini
        </button>
      </div>

      <div id="caseTabsContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>
  </nav>

  <!-- ==================== MAIN 2-COLUMN WORKSPACE ==================== -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- LEFT COLUMN (5 cols on lg): Case Narrative + Interactive Excel Spreadsheet -->
      <section class="lg:col-span-5 flex flex-col gap-5 lg:sticky lg:top-44">
        <!-- Case Narrative Card -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="bg-gradient-to-r from-excel-700 to-excel-600 px-5 py-3.5 text-white flex items-center justify-between gap-2">
            <div>
              <span id="caseLevelBadge" class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-white/20 text-white mb-1">
                Level: Near Transfer
              </span>
              <h2 id="caseTitle" class="text-base sm:text-lg font-extrabold leading-snug">
                Kasus 1: Rekap Kas & Kehadiran Piket
              </h2>
            </div>
            <div id="caseStatusPill" class="shrink-0 px-3 py-1 rounded-full text-xs font-bold bg-amber-400/20 text-amber-100 border border-amber-300/30">
              Sedang Dikerjakan
            </div>
          </div>

          <div class="p-5 space-y-3.5">
            <p id="caseNarrative" class="text-sm text-slate-700 leading-relaxed">
              <!-- Narrative injected here -->
            </p>

            <!-- Goal Box -->
            <div class="bg-emerald-50/80 border border-emerald-200 rounded-xl p-3.5 flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-excel-600 text-white flex items-center justify-center shrink-0 mt-0.5 text-xs">
                <i class="fa-solid fa-bullseye"></i>
              </div>
              <div>
                <h3 class="text-xs font-extrabold uppercase tracking-wide text-excel-800">Misi Tantangan</h3>
                <p id="caseMission" class="text-xs sm:text-sm font-medium text-emerald-950 mt-0.5">
                  <!-- Mission injected here -->
                </p>
              </div>
            </div>

            <!-- Cognitive Trap Warning Box -->
            <div class="bg-amber-50/90 border border-amber-200 rounded-xl p-3 flex items-start gap-2.5">
              <i class="fa-solid fa-triangle-exclamation text-amber-600 mt-0.5 text-sm"></i>
              <p id="caseTrapHint" class="text-xs text-amber-900 leading-relaxed">
                <!-- Trap clue injected here -->
              </p>
            </div>
          </div>
        </div>

        <!-- Interactive Excel Spreadsheet Card -->
        <div class="bg-white rounded-2xl border border-slate-300 shadow-sm overflow-hidden">
          <!-- Window Title Bar -->
          <div class="bg-excel-600 text-white px-4 py-2 flex items-center justify-between text-xs font-semibold">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-file-excel"></i>
              <span id="sheetFileName">BukuKerja_Kasus1.xlsx</span>
            </div>
            <span class="text-emerald-100 text-[11px]">Klik sel untuk melihat alamat koordinat</span>
          </div>

          <!-- Excel Formula Bar -->
          <div class="bg-slate-50 border-b border-slate-300 px-3 py-2 flex items-center gap-2">
            <!-- Name Box (Active Cell Coordinate) -->
            <div
              id="activeCellNameBox"
              class="w-16 text-center font-mono text-xs font-bold bg-white border border-slate-300 rounded-lg py-1.5 text-slate-800 shadow-inner"
              title="Alamat Sel Aktif"
            >
              C8
            </div>

            <!-- fx Icon -->
            <div class="px-2 py-1 text-slate-400 font-serif italic font-bold text-sm select-none border-r border-slate-200">
              fx
            </div>

            <!-- Formula Bar Display -->
            <div id="spreadsheetFormulaDisplay" class="flex-grow font-mono text-xs bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-slate-500 flex items-center justify-between overflow-x-auto">
              <span class="inline-flex items-center gap-1.5 text-amber-700 font-sans font-semibold">
                <i class="fa-solid fa-lock text-[11px]"></i> Selesaikan Prediksi Hasil Terlebih Dahulu
              </span>
            </div>
          </div>

          <!-- Spreadsheet Table Grid -->
          <div class="overflow-x-auto excel-grid-scroll">
            <table id="excelGridTable" class="w-full border-collapse text-xs sm:text-sm select-none">
              <!-- Rendered dynamically by JS -->
            </table>
          </div>

          <!-- Spreadsheet Footer Legend -->
          <div class="bg-slate-50 border-t border-slate-200 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-600">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-3 h-3 rounded bg-emerald-100 border-2 border-excel-600 inline-block"></span> Sel Target Formula
              </span>
              <span id="legendRefCell" class="hidden inline-flex items-center gap-1.5">
                <span class="w-3 h-3 rounded bg-amber-100 border border-amber-500 inline-block"></span> Sel Acuan Tetap
              </span>
            </div>
            <span class="font-mono text-slate-400">Ready • Calc: Auto</span>
          </div>
        </div>
      </section>

      <!-- RIGHT COLUMN (7 cols on lg): 3 Locked Pedagogical Phases -->
      <section class="lg:col-span-7 flex flex-col gap-5">

        <!-- ==================== TAHAP 1: FUNCTION SELECTION (TWO-TIER) ==================== -->
        <div id="phase1Card" class="bg-white rounded-2xl border-2 border-excel-600 shadow-sm overflow-hidden transition-all">
          <div class="px-5 py-4 bg-emerald-50/70 border-b border-emerald-100 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-excel-600 text-white font-extrabold text-sm flex items-center justify-center shadow-sm">
                1
              </span>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
                    Tahap 1: Function Selection (Two-Tier Diagnostic)
                  </h3>
                </div>
                <p class="text-xs text-slate-600">Pilih fungsi yang tepat beserta alasan logisnya sebelum menulis rumus</p>
              </div>
            </div>
            <span id="phase1Badge" class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-excel-800">
              <i class="fa-solid fa-unlock mr-1"></i> Aktif
            </span>
          </div>

          <div id="phase1Body" class="p-5 space-y-5">
            <!-- Tier 1: Function Cards -->
            <div>
              <label class="block text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-2.5">
                Langkah 1A — Pilih Alat / Fungsi Excel yang Paling Tepat:
              </label>
              <div id="functionOptionsGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                <!-- Function option buttons injected here -->
              </div>
            </div>

            <!-- Tier 2: Logical Reason -->
            <div>
              <label class="block text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-2.5">
                Langkah 1B — Mengapa Fungsi Tersebut Dipilih? (Alasan Logis):
              </label>
              <div id="reasonOptionsList" class="space-y-2">
                <!-- Reason radio cards injected here -->
              </div>
            </div>

            <!-- Phase 1 Feedback Alert -->
            <div id="phase1Feedback" class="hidden rounded-xl p-3.5 text-xs sm:text-sm leading-relaxed"></div>

            <!-- Phase 1 Action Button -->
            <div class="flex items-center justify-between pt-1">
              <span id="phase1AttemptsText" class="text-xs text-slate-500 font-medium">
                Percobaan diagnosa: 0 kali
              </span>
              <button
                type="button"
                id="btnVerifyPhase1"
                onclick="verifyPhase1()"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-excel-600 hover:bg-excel-700 shadow-sm transition active:scale-[0.99]"
              >
                <i class="fa-solid fa-check-circle"></i>
                <span>Verifikasi Pilihan & Alasan</span>
              </button>
            </div>
          </div>
        </div>

        <!-- ==================== TAHAP 2: OUTPUT PREDICTION (MENTAL TRACING) ==================== -->
        <div id="phase2Card" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden transition-all relative">
          <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span id="phase2Number" class="w-8 h-8 rounded-xl bg-slate-300 text-slate-600 font-extrabold text-sm flex items-center justify-center">
                2
              </span>
              <div>
                <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
                  Tahap 2: Output Prediction (Simulasi Mental / Tracing)
                </h3>
                <p class="text-xs text-slate-600">Prediksi hasil di kepala terlebih dahulu untuk mencegah coba-coba buta</p>
              </div>
            </div>
            <span id="phase2Badge" class="px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-600">
              <i class="fa-solid fa-lock mr-1"></i> Terkunci
            </span>
          </div>

          <!-- Locked Banner -->
          <div id="phase2LockedOverlay" class="p-6 text-center bg-slate-50/60">
            <div class="w-11 h-11 rounded-full bg-slate-200/80 text-slate-500 flex items-center justify-center mx-auto mb-2.5">
              <i class="fa-solid fa-lock text-lg"></i>
            </div>
            <p class="text-sm font-bold text-slate-700">Tahap Prediksi Hasil Masih Terkunci</p>
            <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
              Selesaikan <span class="font-semibold text-excel-700">Tahap 1 (Memilih Fungsi & Alasan Logis)</span> terlebih dahulu untuk membuka simulasi prediksi hasil.
            </p>
          </div>

          <!-- Unlocked Content -->
          <div id="phase2Body" class="hidden p-5 space-y-4 fade-in">
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-900 flex items-center gap-2.5">
              <i class="fa-solid fa-lightbulb text-amber-600 text-base shrink-0"></i>
              <span>
                <strong>Aturan Detektif Data:</strong> Editor rumus Excel sengaja dikunci sampai kamu mengunci prediksi hasil perhitungan manualmu di bawah ini!
              </span>
            </div>

            <div id="predictionQuestionsContainer" class="space-y-4">
              <!-- Dynamic prediction inputs injected here -->
            </div>

            <div id="phase2Feedback" class="hidden rounded-xl p-3.5 text-xs sm:text-sm"></div>

            <div class="flex items-center justify-end pt-1">
              <button
                type="button"
                id="btnLockPrediction"
                onclick="lockPredictions()"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-amber-600 hover:bg-amber-700 shadow-sm transition active:scale-[0.99]"
              >
                <i class="fa-solid fa-key"></i>
                <span>Kunci Prediksi & Buka Editor Excel</span>
              </button>
            </div>
          </div>
        </div>

        <!-- ==================== TAHAP 3: FORMULA TESTING & DEBUGGING SANDBOX ==================== -->
        <div id="phase3Card" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden transition-all">
          <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span id="phase3Number" class="w-8 h-8 rounded-xl bg-slate-300 text-slate-600 font-extrabold text-sm flex items-center justify-center">
                3
              </span>
              <div>
                <h3 class="text-sm sm:text-base font-extrabold text-slate-900">
                  Tahap 3: Formula Testing & Debugging Sandbox
                </h3>
                <p class="text-xs text-slate-600">Ketik formula pada Formula Bar, jalankan simulasi, dan bandingkan dengan prediksimu</p>
              </div>
            </div>
            <span id="phase3Badge" class="px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-600">
              <i class="fa-solid fa-lock mr-1"></i> Terkunci
            </span>
          </div>

          <!-- Locked Banner -->
          <div id="phase3LockedOverlay" class="p-6 text-center bg-slate-50/60">
            <div class="w-11 h-11 rounded-full bg-slate-200/80 text-slate-500 flex items-center justify-center mx-auto mb-2.5">
              <i class="fa-solid fa-terminal text-lg"></i>
            </div>
            <p class="text-sm font-bold text-slate-700">Editor Formula Excel Terkunci</p>
            <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
              Selesaikan <span class="font-semibold text-amber-700">Tahap 2 (Prediksi Hasil)</span> untuk membuka Formula Bar interaktif dan menguji rumusmu.
            </p>
          </div>

          <!-- Unlocked Content -->
          <div id="phase3Body" class="hidden p-5 space-y-5 fade-in">
            <!-- Interactive Formula Input Box -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="formulaInput" class="text-xs font-extrabold uppercase tracking-wider text-slate-700">
                  Formula Bar untuk Sel <span id="targetCellLabel" class="font-mono text-excel-700 bg-emerald-100 px-1.5 py-0.5 rounded">C8</span>:
                </label>
                <span class="text-[11px] text-slate-500">Mendukung pemisah <code class="font-mono bg-slate-100 px-1 rounded">,</code> maupun <code class="font-mono bg-slate-100 px-1 rounded">;</code></span>
              </div>

