    function syncFormulaBarMirror() {
      const val = document.getElementById('formulaInput').value;
      caseStates[currentCaseIdx].lastFormula = val;
      selectedCellCoord = CASES_DATA[currentCaseIdx].primaryTargetCell;
      updateFormulaBarDisplay();
    }

    function insertSnippet(snippet) {
      const input = document.getElementById('formulaInput');
      const start = input.selectionStart || input.value.length;
      const end = input.selectionEnd || input.value.length;
      const current = input.value;
      input.value = current.slice(0, start) + snippet + current.slice(end);
      input.focus();
      const cursorPos = snippet === '""' ? start + 1 : start + snippet.length;
      input.setSelectionRange(cursorPos, cursorPos);
      syncFormulaBarMirror();
    }

    function executeFormulaTest() {
      const c = CASES_DATA[currentCaseIdx];
      const st = caseStates[currentCaseIdx];
      const rawFormula = document.getElementById('formulaInput').value.trim();

      if (!rawFormula) {
        const diagBox = document.getElementById('phase3DiagnosticBox');
        diagBox.classList.remove('hidden');
        diagBox.className = 'rounded-xl p-4 text-xs sm:text-sm bg-amber-50 border border-amber-200 text-amber-900';
        diagBox.innerHTML = '<i class="fa-solid fa-keyboard mr-1.5 text-amber-600"></i> Ketikkan formula Excel terlebih dahulu pada kotak <b>fx</b> di atas (diawali tanda <code>=</code>).';
        return;
      }

      st.phase3Attempts++;
      st.lastFormula = rawFormula;
      st.evaluatedCells = {};

      // Evaluate across all target cells (simulating autofill for Kasus 4)
      const primaryRowIdx = parseCellCoord(c.primaryTargetCell).rowIdx;
      let allMatched = true;
      let syntaxErrorType = null;

      c.targetCells.forEach((cellCoord) => {
        const rowDelta = parseCellCoord(cellCoord).rowIdx - primaryRowIdx;
        const evalRes = runExcelFormula(rawFormula, c.grid, rowDelta);
        if (evalRes.error) {
          syntaxErrorType = evalRes.error;
        }
        st.evaluatedCells[cellCoord] = evalRes.value;

        const expected = c.expectedOutputs[cellCoord];
        if (String(evalRes.value).toLowerCase() !== String(expected).toLowerCase()) {
          allMatched = false;
        }
      });

      // Refresh Spreadsheet Grid so user sees live results in cells!
      renderSpreadsheetGrid();
      renderComparisonAndDiagnostics(syntaxErrorType, allMatched);

      if (allMatched && !syntaxErrorType) {
        st.completed = true;
        logActivity(
          'Tahap 3 (Test)',
          c.code,
          `SUKSES! Formula "${rawFormula}" menghasilkan output valid pada semua sel target (Uji ke-${st.phase3Attempts})`,
          'success'
        );
      } else {
        logActivity(
          'Tahap 3 (Debug)',
          c.code,
          `Uji ke-${st.phase3Attempts} dengan "${rawFormula}" masih perlu perbaikan`,
          'error'
        );
      }

      renderCaseTabs();
      loadCaseHeaderAndPhase3Footer();
      updateResearchMetrics();
    }

