    function loadCase(idx) {
      currentCaseIdx = idx;
      const c = CASES_DATA[idx];
      const st = caseStates[idx];
      selectedCellCoord = c.primaryTargetCell;

      renderCaseTabs();

      // Update Left Column Narrative
      document.getElementById('caseLevelBadge').textContent = `Level: ${c.level}`;
      document.getElementById('caseTitle').textContent = `${c.code}: ${c.title}`;
